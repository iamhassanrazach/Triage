# ---------- LLM (any OpenAI-compatible provider) ----------
# Example with OpenRouter (has free models). Check the exact model names on openrouter.ai/models
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Default model:
LLM_MODEL=
# Optional: more models for the front-end menu (comma separated, F5 model switching)
LLM_MODELS=
# Optional prices in USD per 1M tokens (leave 0 for free models) - used to compute "cost"
# "Thinking" models: reasoning effort and extra token room (avoid empty answers)
LLM_REASONING_EFFORT=low
LLM_REASONING_HEADROOM=1500
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# ---------- Decision model (System One API) ----------
# Free key in one click (no account) on https://decision.vllm-sr.ai
DM_BASE_URL=https://decision.vllm-sr.ai
DM_API_KEY=
DM_MODEL=vllm-sr/d3-turbo
# Optional menu of decision models (comma separated)
DM_MODELS=vllm-sr/d3-turbo,vllm-sr/d3-flash
DM_PRICE_INPUT_PER_M=0
# dm+llm: below this DM confidence the LLM takes over
DM_CONFIDENCE_THRESHOLD=0.6

# Smoke test: how many tickets are processed in parallel (lower it if you get rate-limited)
SMOKE_CONCURRENCY=3
